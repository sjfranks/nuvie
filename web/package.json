{
  "name": "nuvie-web",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-2.0-or-later",
  "description": "A TypeScript port of the Nuvie engine for phones and browsers. Plays the player's own game data.",
  "type": "module",
  "scripts": {
